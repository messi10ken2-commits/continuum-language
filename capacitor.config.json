{
  "appId": "com.continuum.language.dev",
  "appName": "Continuum",
  "loggingBehavior": "none",
  "webDir": "dist-native",
  "server": {
    "iosScheme": "capacitor",
    "hostname": "localhost"
  },
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "backgroundColor": "#fffdfb",
    "scrollEnabled": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "Keyboard": {
      "resize": "native",
      "style": "LIGHT"
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#fffdfb",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#fffdfb"
    },
    "PushNotifications": {
      "presentationOptions": [
        "banner",
        "list",
        "sound"
      ]
    }
  }
}
