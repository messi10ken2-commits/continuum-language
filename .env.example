# Configure these through deployment secret settings. Do not commit real values.
# At least one monthly/yearly positive recurring Price is required.
BILLING_ENABLED=false
BILLING_STRIPE_MODE=test
BILLING_SANDBOX_DEPLOYMENT=false
BILLING_LIVE_APPROVED=false
# Live requires an explicit tax decision: automatic or off.
BILLING_TAX_MODE=
BILLING_MONTHLY_AMOUNT_CENTS=999
BILLING_YEARLY_AMOUNT_CENTS=7999
PREMIUM_TICKET_PROGRAMME_ENABLED=false
BILLING_PUBLIC_URL=https://continuum-language-production.up.railway.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
# Retain old Premium price IDs when replacing prices (comma-separated).
STRIPE_PREMIUM_LEGACY_PRICE_IDS=
PREMIUM_TICKET_MAX_MINUTES=60

# Premium AI session duration in seconds; bounded to 900–3600. Free stays 420.
PREMIUM_CONVERSATION_SECONDS=1800

# Optional store Sandbox verification. Use only on isolated Staging or locally.
STORE_BILLING_SANDBOX=false
APPLE_STORE_BUNDLE_ID=
APPLE_STORE_ISSUER_ID=
APPLE_STORE_KEY_ID=
APPLE_STORE_PRIVATE_KEY=
APPLE_STORE_PRODUCT_IDS=
GOOGLE_PLAY_PACKAGE_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
GOOGLE_PLAY_PRODUCT_IDS=
