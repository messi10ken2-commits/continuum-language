# Configure these through deployment secret settings. Do not commit real values.
# Build-time opt-in for isolated Continuum World Tokyo previews. Rebuild to change it.
VITE_CONTINUUM_WORLD_TOKYO_BETA=false
PREMIUM_TICKET_PROGRAMME_ENABLED=false
PREMIUM_TICKET_MAX_MINUTES=60

# Premium AI session duration in seconds; bounded to 900–3600. Free stays 420.
PREMIUM_CONVERSATION_SECONDS=1800

# Optional store Sandbox verification. Use only on isolated Staging or locally.
STORE_BILLING_SANDBOX=false
APPLE_STORE_BUNDLE_ID=
APPLE_STORE_ISSUER_ID=
APPLE_STORE_KEY_ID=
APPLE_STORE_PRIVATE_KEY=
APPLE_STORE_PRODUCT_IDS=
GOOGLE_PLAY_PACKAGE_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
GOOGLE_PLAY_PRODUCT_IDS=

# Optional password-reset delivery adapter; configure only after approving a mailer.
AUTH_MAILER_WEBHOOK_URL=
AUTH_MAILER_WEBHOOK_TOKEN=
AUTH_RECOVERY_PUBLIC_ORIGIN=https://continuum-language-production.up.railway.app

# Approved transactional mail; do not commit real values.
AUTH_MAIL_PROVIDER=smtp
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_MAIL_FROM=
MAIL_OUTBOX_KEY=
READINESS_MAINTENANCE_ENABLED=false

# No default retention policy: publish and approve actual periods first.
ACCOUNT_DELETION_ENABLED=false
ACCOUNT_DELETION_POLICY_PUBLISHED=false
ACCOUNT_DELETION_POLICY_VERSION=
ACCOUNT_DELETION_PROCESSING_DAYS=
ACCOUNT_DELETION_RETENTION_DAYS=
ACCOUNT_DELETION_BACKUP_DAYS=

# Release purchasing stays disabled independently.
APPLE_STORE_SERVER_ENABLED=false
APPLE_STORE_ENVIRONMENT=Sandbox
APPLE_STORE_APP_ID=
APPLE_STORE_LIVE_APPROVED=false
